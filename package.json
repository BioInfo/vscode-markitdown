{
  "name": "markitdown-vscode",
  "displayName": "MarkItDown",
  "description": "Convert PDF, DOCX, PPTX, XLSX, images, audio, and more to Markdown with one click",
  "version": "0.3.0",
  "publisher": "bioinfo",
  "author": {
    "name": "bioinfo",
    "email": "bioinfo@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BioInfo/vscode-markitdown.git"
  },
  "bugs": {
    "url": "https://github.com/BioInfo/vscode-markitdown/issues"
  },
  "homepage": "https://github.com/BioInfo/vscode-markitdown#readme",
  "icon": "markitdown.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "converter",
    "pdf",
    "docx",
    "pptx",
    "xlsx",
    "html",
    "csv",
    "json",
    "xml",
    "image",
    "audio",
    "ocr",
    "transcription",
    "markitdown",
    "file conversion",
    "document converter"
  ],
  "qna": "marketplace",
  "activationEvents": [
    "onCommand:markitdown.convertFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markitdown.convertFile",
        "title": "MarkItDown: Convert File to Markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "markitdown.convertFile",
          "when": "resourceExtname =~ /\\.(pdf|docx|pptx|xlsx|html|csv|json|xml|png|jpg|jpeg|gif|mp3|wav|zip)$/i",
          "group": "markitdown"
        }
      ]
    },
    "configuration": {
      "title": "MarkItDown",
      "properties": {
        "markitdown.openFileOnSuccess": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the generated Markdown file after successful conversion"
        },
        "markitdown.overwriteExisting": {
          "type": "boolean",
          "default": false,
          "description": "Overwrite existing Markdown files instead of creating numbered variants"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && npm run lint && npm run test:functional",
    "test:functional": "node scripts/functional-test.mjs",
    "test:vscode": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@types/mocha": "^10.0.1",
    "@types/glob": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {}
}